---
import { SEO } from "astro-seo";
import { SITE_URL } from "@/data/config";
import information from "@/data/information";

type Props = {
  title?: string;
  description?: string;
  noindex?: boolean;
  canonical?: string;
  og?: {
    title: string;
    type: string;
    description: string;
    image: string;
    alt: string;
    width?: number;
    height?: number;
  };
};

const { title, description, noindex, canonical, og } = Astro.props;

const canonicalURL = canonical || Astro.url.href;

const DEFAULT_TITLE_PAGE = "Artiteatre - Nadia Banegas";
const DEFAULT_DESCRIPTION_PAGE =
  "La escuela de Nadia Banegas, que integra tres iniciativas educativas: EL TRAÇ (Escuela de arte), AULA VIVA (Escuela de verano) y TOT TEATRE (Escuela de teatro), cada una con un enfoque único, caracterizado por un trabajo honesto, meticuloso y ético";
const DEFAULT_URL_SITE = SITE_URL;
const DEFAULT_IMAGE = `${DEFAULT_URL_SITE}opengraph-image.jpg`;

const jsonLD = {
  "@context": "https://schema.org",
  "@type": ["LocalBusiness", "EducationalOrganization"],
  name: "Artiteatre",
  url: DEFAULT_URL_SITE,
  description: DEFAULT_DESCRIPTION_PAGE,
  founder: { "@type": "Person", name: "Nadia Banegas" },
  address: {
    "@type": "PostalAddress",
    streetAddress: "Pasaje Isidoro Macabich Edfo Olimpo, 20 bis, 6º 3ª",
    addressLocality: "Ibiza",
    postalCode: "07800",
    addressCountry: "ES",
  },
  telephone: information.phone,
  email: information.mail,
  sameAs: information.socials.map((s) => s.link),
};

const openGraph = {
  title: og?.title || DEFAULT_TITLE_PAGE,
  type: og?.type || "website",
  image: og?.image || DEFAULT_IMAGE,
  alt: og?.alt || "Artiteatre — escuela de arte y teatro en Ibiza",
  url: canonicalURL,
  description: og?.description || DEFAULT_DESCRIPTION_PAGE,
  width: og?.width,
  height: og?.height,
};
---

<head>
  <SEO
    charset="UTF-8"
    title={title || DEFAULT_TITLE_PAGE}
    description={description || DEFAULT_DESCRIPTION_PAGE}
    noindex={noindex || false}
    canonical={canonicalURL}
    openGraph={{
      basic: {
        title: openGraph.title,
        type: openGraph.type,
        image: openGraph.image,
        url: openGraph.url,
      },
      optional: {
        description: openGraph.description,
        ...(openGraph.width && { width: openGraph.width }),
        ...(openGraph.height && { height: openGraph.height }),
      },
      image: {
        alt: openGraph.alt,
      },
    }}
    twitter={{
      imageAlt: openGraph.alt,
    }}
    extend={{
      link: [
        { rel: "icon", href: "/favicon.svg" },
        { rel: "sitemap", href: "/sitemap-index.xml" },
        { rel: "preconnect", href: "https://cdnjs.cloudflare.com" },
        { rel: "dns-prefetch", href: "https://cdnjs.cloudflare.com" },
      ],
      meta: [
        { name: "viewport", content: "width=device-width, initial-scale=1" },
        { name: "generator", content: Astro.generator },
        { property: "og:locale", content: "es_ES" },
        { name: "twitter:image", content: openGraph.image },
        { name: "twitter:card", content: "summary_large_image" },
        { name: "twitter:title", content: openGraph.title },
        { name: "twitter:description", content: openGraph.description },
      ],
    }}
  />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLD)} />
</head>
