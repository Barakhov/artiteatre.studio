---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

const modules = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/galleries/verano-hero/*.jpg",
  { eager: true }
);

const images = Object.entries(modules)
  .map(([path, mod]) => {
    const num = parseInt(path.match(/(\d+)\.jpg$/)?.[1] ?? "0");
    return { src: mod.default, alt: `Aula viva foto: imagen ${num}`, num };
  })
  .sort((a, b) => a.num - b.num);
---

<div
  class="slideshow-container relative w-full aspect-[4/3] overflow-hidden rounded-2xl shadow-md"
>
  {
    images.map(({ src, alt }, index) => (
      <div
        class:list={[
          "absolute inset-0 w-full h-full transition-opacity duration-1000",
          index === 0 ? "opacity-100" : "opacity-0",
        ]}
        data-slide={index}
      >
        <Image
          src={src}
          alt={alt}
          class="w-full h-full object-cover"
          width={1200}
          height={900}
          loading={index === 0 ? "eager" : "lazy"}
          fetchpriority={index === 0 ? "high" : undefined}
          decoding="async"
        />
      </div>
    ))
  }
</div>

<script is:inline>
  document.addEventListener("astro:page-load", () => {
    const slides = document.querySelectorAll("[data-slide]");
    let currentSlide = 0;
    const slideInterval = 3000; // 3 seconds per slide

    function nextSlide() {
      const nextIndex = (currentSlide + 1) % slides.length;

      gsap.to(slides[currentSlide], {
        opacity: 0,
        duration: 1,
        ease: "power2.inOut",
      });

      gsap.to(slides[nextIndex], {
        opacity: 1,
        duration: 1,
        ease: "power2.inOut",
      });

      currentSlide = nextIndex;
    }

    // Start the slideshow
    setInterval(nextSlide, slideInterval);
  });
</script>
