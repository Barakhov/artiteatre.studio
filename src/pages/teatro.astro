---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/shared/Container.astro";
---

<Layout
  title="Tot Teatre — Escuela de teatro en Ibiza | Artiteatre"
  description="Tot Teatre es la escuela de teatro de Artiteatre en Ibiza. Clases para niños, jóvenes y adultos, grupos amateurs y obra de fin de curso."
>
  <div
    class="absolute top-[71px] w-full h-24 z-20 bg-gradient-to-b from-teatro-primary/30 to-teatro-primary/0"
  >
  </div>
  <main class="relative z-10 bg-white shadow-main">
    <Container>
      <div
        class="grid h-[calc(100dvh-71px)] place-content-center bg-white px-4"
      >
        <div class="text-center">
          <h1 class="mb-6 text-sm font-semibold uppercase tracking-widest text-gray-400">
            Tot Teatre — Escuela de teatro en Ibiza
          </h1>
          <img
            src="/illustrations/teatro-artwork.svg"
            alt="Ilustración de Tot Teatre, escuela de teatro"
            class="mx-auto h-56 w-auto sm:h-64"
            width="1024"
            height="768"
          />

          <h2
            class="mt-6 text-2xl font-bold tracking-tight text-gray-800 sm:text-4xl"
          >
            ¡Vaya!
          </h2>

          <p class="mt-4 mb-6 text-gray-600 mx-auto max-w-lg">
            Parece que aún no hay contenido por aquí.
          </p>
          <a
            class="py-1 px-4 bg-gray-100 rounded-full hover:bg-gray-800 hover:text-white transition-colors duration-300 text-lg"
            href="/">Volver al inicio</a
          >
        </div>
      </div>
    </Container>
  </main>
</Layout>
