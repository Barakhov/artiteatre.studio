---
import { ViewTransitions } from "astro:transitions";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import SEOTags from "@/components/seo/SEOTags.astro";

import "@/styles/fonts.css";

import "@/styles/tailwind.css";

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
  gsap?: boolean;
}

const { title, description, canonical, noindex, gsap } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <SEOTags title={title} description={description} canonical={canonical} noindex={noindex} />
  <ViewTransitions />
  <body class="min-h-[100dvh] flex flex-col">
    <style is:global>
      html {
        font-family: "Hanken Grotesk", "Hanken Grotesk Fallback", sans-serif;
      }
    </style>
    <Header />
    <slot />
    <Footer />

    <script src="../scripts/pageLoad.js"></script>

    {gsap && (
      <>
        <script
          defer
          src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.3/gsap.min.js"
        ></script>
        <script
          defer
          src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.3/ScrollTrigger.min.js"
        ></script>
      </>
    )}
  </body>
</html>
